8.3 Lógica (mola com inércia, loop único em requestAnimationFrame)
const tt=[...document.querySelectorAll('.tt')], star=document.getElementById('star');
const still=matchMedia('(prefers-reduced-motion:reduce)').matches;
const S={x:innerWidth*.12,y:160,vx:0,vy:0,i:0,mode:'dock',last:0,lastY:scrollY,vel:0};

const anchor=h=>{const r=h.getBoundingClientRect(),c=getComputedStyle(h).textAlign==='center';
  return{x:r.left+(c?r.width/2:22), y:r.top-34, top:r.top, bottom:r.bottom}};
const clampY=y=>Math.min(innerHeight-60,Math.max(70,y));

function dot(x,y,far=40){const d=document.createElement('i');d.className='pt';d.style.left=x+'px';d.style.top=y+'px';
  d.style.setProperty('--dx',((Math.random()-.5)*far)+'px');d.style.setProperty('--dy',((Math.random()-.5)*far)+'px');
  document.body.appendChild(d);setTimeout(()=>d.remove(),1200)}
function land(h){for(let i=0;i<16;i++)dot(S.x,S.y,160);h.classList.add('lit')}

// decide qual título é o atual: o último cujo topo já passou de 70% da altura da tela
function pickIndex(){let d=0;tt.forEach((h,i)=>{if(h.getBoundingClientRect().top<innerHeight*.7)d=i});return d}

let prev=performance.now();
function frame(now){
  const dt=Math.min(.05,(now-prev)/1000);prev=now;
  S.vel=Math.abs(scrollY-S.lastY)/Math.max(dt,.001);S.lastY=scrollY;
  const d=pickIndex();
  if(d!==S.i){S.i=d;S.mode='fly';S.flyStart=now}
  const a=anchor(tt[S.i]), rideX=innerWidth>820?innerWidth*.05:18, rideY=innerHeight*.38+Math.sin(now/700)*14;
  const visible=a.bottom>80&&a.top<innerHeight-40;
  let tx,ty,k,c;
  if(S.mode==='fly'){tx=a.x;ty=clampY(a.y);k=70;c=2*Math.sqrt(k)*.62;                 // voo: mola solta, faz arco
    if(Math.hypot(S.x-tx,S.y-ty)<8&&visible){S.mode='dock';land(tt[S.i])}}
  else if(S.mode==='dock'){tx=a.x;ty=a.y;k=220;c=2*Math.sqrt(k);                       // gruda no título
    if(!visible)S.mode='ride'}
  else{tx=rideX;ty=rideY;k=34;c=2*Math.sqrt(k)*.8;                                       // acompanha a rolagem
    if(visible&&a.top<innerHeight*.7)S.mode='fly'}
  // arco: acrescenta desvio lateral proporcional à distância durante o voo
  const dist=Math.hypot(tx-S.x,ty-S.y), side=S.mode==='fly'?Math.sin(Math.min(1,dist/500)*Math.PI)*120:0;
  const ax=(tx-S.x)*k-S.vx*c+side*k*.004, ay=(ty-S.y)*k-S.vy*c;
  if(still){S.x=tx;S.y=ty}else{S.vx+=ax*dt;S.vy+=ay*dt;S.x+=S.vx*dt;S.y+=S.vy*dt}
  star.style.transform=`translate(${S.x}px,${S.y}px)`;
  if(!still&&(S.mode!=='dock')&&now-S.last>(S.mode==='fly'?25:Math.max(60,220-S.vel/8))){S.last=now;dot(S.x,S.y,S.mode==='fly'?40:26)}
  requestAnimationFrame(frame)}
requestAnimationFrame(frame);
function snap(){const a=anchor(tt[S.i]);S.x=a.x;S.y=clampY(a.y);S.vx=S.vy=0}
addEventListener('resize',snap);addEventListener('load',snap);snap();tt[0].classList.add('lit');
